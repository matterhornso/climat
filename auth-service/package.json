{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "authentication service for shine platform",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/shine2/auth-service.git"
  },
  "scripts": {
    "build": "npm run build:all && tsc -p . && npm run copy-static-assets",
    "tsoa:gen": "yarn tsoa swagger -c ./api/tsoa.json && yarn tsoa routes -c ./api/tsoa.json",
    "clean": "rimraf dist",
    "test": "ENVIRONMENT=test mocha -r ts-node/register src/**/*.spec.ts src/**/**/*.spec.ts --timeout 10000 --exit",
    "copy-static-assets": "ts-node copyStaticAssets.ts",
    "dev": "npm run build && concurrently \"nodemon --inspect\" \"nodemon -x tsoa spec-and-routes\"",
    "start": "npm run clean && npm run build && node dist/src/infrastructure/server.js",
    "build:routes": "mkdir -p src/infrastructure/routes && tsoa routes",
    "build:swagger": "mkdir -p api && mkdir -p api/dist && tsoa swagger",
    "build:all": "npm run build:routes && npm run build:swagger",
    "start-local": "ENVIRONMENT=local npm start",
    "generate": "tsoa spec"
  },
  "author": "amit maurya",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/logging-bunyan": "^3.0.2",
    "@types/bunyan": "^1.8.6",
    "@types/morgan": "^1.9.1",
    "@types/on-finished": "^2.3.1",
    "@types/superagent": "^4.1.10",
    "@types/swagger-ui-express": "^4.1.2",
    "body-parser": "^1.19.0",
    "bunyan": "^1.8.15",
    "captchapng2": "^1.0.3",
    "dotenv": "^8.2.0",
    "email-validator": "^2.0.4",
    "errorhandler": "^1.5.1",
    "express": "^4.17.1",
    "faker": "^4.1.0",
    "helmet": "^5.1.0",
    "jsonwebtoken": "^8.5.1",
    "mime": "^3.0.0",
    "moment": "^2.29.1",
    "mongoose": "^6.2.9",
    "morgan": "^1.10.0",
    "on-finished": "^2.3.0",
    "prom-client": "^13.1.0",
    "shelljs": "^0.8.4",
    "speakeasy": "^2.0.0",
    "superagent": "^6.1.0",
    "swagger-ui-express": "^4.1.4",
    "tsoa": "^4.1.0",
    "uuid": "^8.3.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@types/chai": "^4.2.11",
    "@types/errorhandler": "^1.5.0",
    "@types/express": "^4.17.6",
    "@types/faker": "^4.1.12",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/mocha": "^7.0.2",
    "@types/node": "^14.0.5",
    "@types/shelljs": "^0.8.8",
    "@types/speakeasy": "^2.0.5",
    "@types/uuid": "^8.3.0",
    "chai": "^4.2.0",
    "concurrently": "^5.3.0",
    "cors": "^2.8.5",
    "husky": "^8.0.1",
    "mocha": "^7.1.2",
    "nodemon": "^2.0.4",
    "ts-node": "^8.10.2",
    "typescript": "^4.6.3"
  }
}
