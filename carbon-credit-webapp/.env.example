# Example environment file for carbon-credit-webapp
# Copy to .env (or .env.production) and fill in real values.
# Do not commit files containing real secrets.

REACT_APP_BASE_URL=
REACT_APP_BLOCKCHAIN_EXPLORER=
REACT_APP_AI_URL=

# Error tracking. Sentry stays completely disabled while this is empty.
REACT_APP_SENTRY_DSN=""
# Tags events so prod/staging noise is separable.
REACT_APP_ENVIRONMENT="development"
